---
interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props;
---

<section id="gallery" class="px-6 py-24 max-w-5xl mx-auto">
  <h2 class="text-2xl md:text-3xl font-bold text-stone-900 mb-2">Gallery</h2>
  <p class="text-stone-400 mb-10">Snapshots from work.</p>

  {images.length > 0 ? (
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
      {images.map((img) => (
        <div class="break-inside-avoid rounded-xl overflow-hidden bg-stone-100">
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            class="w-full h-auto object-cover hover:scale-[1.02] transition-transform duration-300"
          />
        </div>
      ))}
    </div>
  ) : (
    <div class="py-16 text-center text-stone-300 border-2 border-dashed border-stone-200 rounded-xl">
      <p class="text-sm">Gallery images coming soon.</p>
    </div>
  )}
</section>

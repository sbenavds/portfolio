---
import { experience } from "../data/experience";
---

<section id="experience" class="px-6 py-24 max-w-3xl mx-auto">
  <h2 class="text-2xl md:text-3xl font-bold text-stone-900 mb-2">Experience</h2>
  <p class="text-stone-400 mb-10">Where I've worked.</p>

  <div class="space-y-10">
    {experience.map((job) => (
      <div class="relative pl-6 border-l-2 border-stone-200">
        {job.current && (
          <span class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-accent border-2 border-stone-50" />
        )}
        {!job.current && (
          <span class="absolute -left-[5px] top-2 w-2 h-2 rounded-full bg-stone-300" />
        )}
        <p class="text-xs font-mono text-stone-400 tracking-wider uppercase">{job.period}</p>
        <h3 class="text-lg font-semibold text-stone-900 mt-1">{job.role}</h3>
        <p class="text-sm text-stone-500 mt-0.5">{job.company}</p>
        <p class="text-sm text-stone-500 mt-2 leading-relaxed">{job.description}</p>
      </div>
    ))}
  </div>
</section>

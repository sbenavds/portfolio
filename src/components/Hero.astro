---

---

<section class="px-6 pt-12 pb-20 max-w-2xl mx-auto">
  <div class="flex items-start justify-between gap-8">
    <div class="flex-1 min-w-0">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-stone-900 dark:text-stone-50 leading-[1.1]">
        Hi, I'm Sergio
      </h1>
      <p class="mt-4 text-base text-stone-500 dark:text-stone-400 leading-relaxed">
        Software engineer building web applications and AI systems.
        Focused on shipping fast with agents and workflows.
      </p>
    </div>

    <div class="shrink-0">
      <div class="w-24 h-24 md:w-28 md:h-28 overflow-hidden bg-stone-100 dark:bg-stone-800" style="border-radius: 22%; box-shadow: 0 0 0 1px rgba(0,0,0,0.04), 0 4px 16px rgba(0,0,0,0.06);">
        <img
          src="/portfolio/avatar.jpg"
          alt="Sergio Benavides"
          class="w-full h-full object-cover scale-135"
          onerror="this.style.display='none'"
        />
      </div>
    </div>
  </div>

  <div class="mt-10">
    <h2 class="text-sm font-medium text-stone-900 dark:text-stone-100 mb-4">What I do</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

      <div class="flex gap-3 p-4 rounded-xl border border-stone-100 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-900/50">
        <svg class="w-5 h-5 mt-0.5 text-stone-400 dark:text-stone-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15A2.25 2.25 0 002.25 6.75v10.5A2.25 2.25 0 004.5 19.5z"/></svg>
        <div>
          <p class="text-xs font-medium text-stone-400 dark:text-stone-500 uppercase tracking-wider">Build End-to-End</p>
          <p class="text-sm text-stone-600 dark:text-stone-300 mt-1">MVPs, full-stack apps, from idea to production.</p>
        </div>
      </div>

      <div class="flex gap-3 p-4 rounded-xl border border-stone-100 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-900/50">
        <svg class="w-5 h-5 mt-0.5 text-stone-400 dark:text-stone-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zm8.446-7.189L18 9.75l-.259-1.035a3.375 3.375 0 00-2.456-2.456L14.25 6l1.035-.259a3.375 3.375 0 002.456-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/></svg>
        <div>
          <p class="text-xs font-medium text-stone-400 dark:text-stone-500 uppercase tracking-wider">AI Driven</p>
          <p class="text-sm text-stone-600 dark:text-stone-300 mt-1">Agents, SDKs, MCPs, and LLM workflows.</p>
        </div>
      </div>

      <div class="flex gap-3 p-4 rounded-xl border border-stone-100 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-900/50">
        <svg class="w-5 h-5 mt-0.5 text-stone-400 dark:text-stone-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm0 8a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zm10 0a1 1 0 011-1h4a1 1 0 011 1v6a1 1 0 01-1 1h-4a1 1 0 01-1-1v-6z"/></svg>
        <div>
          <p class="text-xs font-medium text-stone-400 dark:text-stone-500 uppercase tracking-wider">Technology Stack</p>
          <p class="text-sm text-stone-600 dark:text-stone-300 mt-1">TanStack, Next.js, Astro, Cloudflare, AWS, Hono, Express, Payload CMS.</p>
        </div>
      </div>

      <div class="flex gap-3 p-4 rounded-xl border border-stone-100 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-900/50">
        <svg class="w-5 h-5 mt-0.5 text-stone-400 dark:text-stone-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <div>
          <p class="text-xs font-medium text-stone-400 dark:text-stone-500 uppercase tracking-wider">Availability</p>
          <p class="text-sm text-stone-600 dark:text-stone-300 mt-1">20 hrs/week for contract or project work.</p>
        </div>
      </div>

    </div>
  </div>
</section>
